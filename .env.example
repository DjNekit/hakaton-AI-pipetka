# Переменные для локальной разработки (compose.yml): скопируйте в .env. На сервере .env пишет CI из секретов.

# Порт интерфейса: http://localhost:5173
COLORPASS_PORT=5173

# GigaChat API (облачный, Сбер) — запасная языковая модель, когда локальная Gemma недоступна. Ключ авторизации — из личного кабинета
# developers.sber.ru (Base64 от «Client ID:Client Secret»). Держите его только в .env — файл не попадает
# в git и в Docker-образы. Без ключа проверка идёт по правилам.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Max и Pro понимают изображения (описание отличий на фото)
GIGACHAT_MODEL=GigaChat-2-Max

# PostgreSQL (сервис db в compose.yml): история проверок и сравнений фото
POSTGRES_PASSWORD=colorpass

# Основная модель — Gemma 4 в LM Studio (Developer → Start Server). Отвечает — используется она, нет — GigaChat.
# По умолчанию — LM Studio на этом компьютере (порт 1234); модель с ноутбука коллеги — его адрес ngrok:
# LOCAL_LLM_URL=https://<домен>.ngrok-free.app/v1
# LOCAL_LLM_URL=http://host.docker.internal:1234/v1
# Идентификатор модели из LM Studio (пусто — первая доступная)
# LOCAL_LLM_MODEL=google/gemma-4-12b
# API-токен LM Studio — только если в LM Studio включена авторизация; без неё оставьте пустым
# LOCAL_LLM_KEY=
