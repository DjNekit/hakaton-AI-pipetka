# Caddy получает и продлевает сертификат Let's Encrypt для домена сам (нужны A-запись на сервер и открытые 80/443).
{$DOMAIN:ai-pipetka.fun} {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000 {
			transport http {
				read_timeout 10m
			}
		}
	}

	# файлы документов и загрузка пакета — сервис checker
	handle /files/* {
		request_body {
			max_size 600MB
		}
		reverse_proxy checker:8001 {
			transport http {
				read_timeout 10m
			}
		}
	}

	# новый интерфейс: статика — сервис prototype, его серверная часть — applications-api (ассистент отвечает потоком)
	redir /new /new/ 308
	handle /new/api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy applications-api:3100 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}
	handle /new/* {
		reverse_proxy prototype:80
	}

	# чат по отчёту — отдельный сервис; ответ идёт потоком (SSE), поэтому без буферизации
	handle /chat/* {
		reverse_proxy chat:3000 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
