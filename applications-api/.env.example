# Сервис applications-api (серверная часть нового интерфейса /new). В Docker переменные задаёт compose.
BETTER_AUTH_URL=http://localhost:5174
BETTER_AUTH_SECRET=
# адреса, которым сразу выдаётся роль «согласующий» (через запятую)
APPROVER_EMAILS=
# адреса, которым сразу выдаётся роль «нормоконтролёр» (через запятую)
NORMCONTROL_EMAILS=
AUTH_DB_PATH=./dev-auth.db
UPLOADS_DIR=./uploads
# ассистент — сервис chat (GigaChat API)
CHAT_URL=http://localhost:3000
# предпроверка PDF до подачи: backend и checker основного сервиса
BACKEND_URL=http://localhost:8000
FILES_URL=http://localhost:8001/files
